# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
tfplan
crash.log
crash.*.log
*.tfvars.backup

# Secrets — never commit real credentials; .env.example documents the shape
.env
.env.*
!.env.example

# OS
.DS_Store

# Python
__pycache__/
*.pyc

# Addon build context (populated by scripts/prepare_addons.py at build time)
odoo-v18/build-addons/*
!odoo-v18/build-addons/.gitkeep
