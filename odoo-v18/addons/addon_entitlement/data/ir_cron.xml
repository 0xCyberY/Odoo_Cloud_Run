<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Runs on the cron-runner service, which carries ODOO_ENTITLEMENTS.
             ENTITLEMENT_VIOLATION log lines feed the log-based metric + alert
             in terraform/shared/monitoring.tf. -->
        <record id="cron_entitlement_audit" model="ir.cron">
            <field name="name">Addon entitlement audit</field>
            <field name="model_id" ref="base.model_ir_module_module"/>
            <field name="state">code</field>
            <field name="code">model._entitlement_audit()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
