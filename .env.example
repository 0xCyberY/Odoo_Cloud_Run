# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed — .env.example is the only one tracked in git.

# Fine-grained GitHub PAT (Contents: read-only is enough) for cloning the
# private addon catalog repos. Read by scripts/prepare_addons.py and
# scripts/onboard_client.py (both load .env automatically via python-dotenv).
GITHUB_TOKEN=

# ── Local-only (read directly from the shell environment, not auto-loaded
#    from this file the way GITHUB_TOKEN is — export them yourself, e.g.
#    `set -a; source .env; set +a`, before running provision.py/onboard_
#    client.py locally) ──────────────────────────────────────────────────
# GCP project the shared stack + terraform state bucket live in.
GCP_PROJECT=

# ── GitHub Actions only — NOT read from this file ──────────────────────────
# CI runs on GitHub-hosted runners, which never see this local, gitignored
# .env. These reach the workflows only via GitHub's own Settings pages, one
# secret/variable at a time. Listed here purely as a reference for what to
# add and where. Repo → Settings → Secrets and variables → Actions:
#
# Secrets tab:
#   GCP_WORKLOAD_IDENTITY_PROVIDER   WIF provider resource path (google-github-actions/auth)
#   GCP_SERVICE_ACCOUNT              Deployer service account email to impersonate
#   ADDONS_GITHUB_TOKEN              Fine-grained PAT, CI's equivalent of local GITHUB_TOKEN above
#   SENDGRID_API_KEY                 SendGrid API key used by the Notify email step
#
# Variables tab:
#   GCP_PROJECT                      Same value as the local var above
#   NOTIFY_EMAIL_FROM                From-address for notification emails
#   NOTIFY_EMAIL_TO                  Admin-credentials / status distribution list
